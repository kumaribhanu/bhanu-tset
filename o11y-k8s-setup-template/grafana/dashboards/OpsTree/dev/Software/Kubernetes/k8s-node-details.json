                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "100 *\nsum by (cluster) (\n  node_memory_MemTotal_bytes{cluster!=\"\"} \n  - \n  node_memory_MemAvailable_bytes{cluster!=\"\"}\n)\n/\nsum by (cluster) (\n  node_memory_MemTotal_bytes{cluster!=\"\"}\n)",
